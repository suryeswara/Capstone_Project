# MedVerify AI Backend Configuration
PROJECT_NAME="MedVerify AI Backend"
VERSION="1.0.0"
API_V1_STR="/api"

# PostgreSQL Server Configuration
POSTGRES_USER=medverify
POSTGRES_PASSWORD=medverify_secret
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=medverify_db

# Security & JWT Configuration
JWT_SECRET_KEY=medverify-super-secret-jwt-key-2026-phase1

# Force SQLite Fallback for Local Dev (Set to false when PostgreSQL is running)
USE_SQLITE_FALLBACK=false

# --- inference pipeline ---------------------------------------------------
# Folder holding models/ vector_db/ meta_models/ gate/  (see docs/INTEGRATION.md)
MEDVERIFY_ARTIFACT_ROOT=./artifacts
# strict (<=1% false accepts) | balanced (<=3%) | lenient (<=8%)
MEDVERIFY_GATE_STRICTNESS=strict
# Optional: Gemini explanations + gate tie-breaker (template fallback if empty)
GEMINI_API_KEY=
# Optional: higher PubMed rate limit
NCBI_API_KEY=
NCBI_EMAIL=
